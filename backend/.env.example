# ==============================================================================
# MemBrain Backend Environment Variables
# ==============================================================================

# Server Port & CORS Origin
PORT=3000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/braindump

# JWT Cookie Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Google Gemini API Key (Gemini 2.5/Flash)
GENAI_API_KEY=your_gemini_api_key_here

# Pinecone Vector Database API Key
PINECONE_API_KEY=your_pinecone_api_key_here
